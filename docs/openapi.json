{
	"openapi": "3.1.1",
	"info": { "title": "Workbench HTTP API", "version": "1" },
	"security": [{ "apiToken": [] }],
	"components": {
		"securitySchemes": { "apiToken": { "type": "http", "scheme": "bearer" } },
		"schemas": {
			"ProblemDetails": {
				"type": "object",
				"properties": {
					"type": { "type": "string" },
					"title": { "type": "string" },
					"status": { "type": "integer" },
					"detail": { "type": "string" },
					"code": { "type": "string" },
					"correlationId": { "type": "string" },
					"issues": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"path": {
									"type": "array",
									"items": { "type": ["string", "integer"] }
								},
								"message": { "type": "string" }
							},
							"required": ["path", "message"]
						}
					}
				},
				"required": [
					"type",
					"title",
					"status",
					"detail",
					"code",
					"correlationId",
					"issues"
				]
			}
		},
		"headers": {
			"CorrelationId": {
				"description": "the correlation ID of the request, also in its log entries",
				"required": true,
				"schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
			}
		}
	},
	"paths": {
		"/api/operations": {
			"get": {
				"operationId": "listOperations",
				"responses": {
					"200": {
						"description": "the operations of the core and the active plugins, sorted by name",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"operations": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"name": { "type": "string" },
													"kind": { "enum": ["query", "mutation"] }
												},
												"required": ["name", "kind"]
											}
										}
									},
									"required": ["operations"]
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the request failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/operations/core.createWorkspace": {
			"post": {
				"operationId": "core.createWorkspace",
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "a key of the caller under which a repeated call receives the answer of the first instead of running the mutation again",
						"schema": { "type": "string", "pattern": "^[ -+\\--~]{1,255}$" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"name": { "type": "string", "minLength": 1, "maxLength": 200 }
								},
								"required": ["name"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"id": { "type": "string" },
										"name": { "type": "string" }
									},
									"required": ["id", "name"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"403": {
						"description": "the call was denied: not_instance_admin",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/ProblemDetails" },
										{
											"properties": {
												"code": { "enum": ["not_instance_admin"] }
											}
										}
									]
								}
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/operations/core.defineRole": {
			"post": {
				"operationId": "core.defineRole",
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "a key of the caller under which a repeated call receives the answer of the first instead of running the mutation again",
						"schema": { "type": "string", "pattern": "^[ -+\\--~]{1,255}$" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"name": {
										"type": "string",
										"pattern": "^[a-z][a-z0-9-]{0,62}$"
									},
									"rights": {
										"maxItems": 200,
										"type": "array",
										"items": {
											"type": "string",
											"minLength": 1,
											"maxLength": 200
										}
									}
								},
								"required": ["name", "rights"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"name": {
											"type": "string",
											"pattern": "^[a-z][a-z0-9-]{0,62}$"
										},
										"rights": { "type": "array", "items": { "type": "string" } }
									},
									"required": ["name", "rights"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"403": {
						"description": "the call was denied: not_instance_admin",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/ProblemDetails" },
										{
											"properties": {
												"code": { "enum": ["not_instance_admin"] }
											}
										}
									]
								}
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/workspaces/{workspace}/operations/core.grantMembership": {
			"post": {
				"operationId": "core.grantMembership",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
