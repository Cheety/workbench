											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"enum": ["user", "service_account"]
												},
												"id": {
													"type": "string",
													"minLength": 1,
													"maxLength": 200
												}
											},
											"required": ["kind", "id"],
											"additionalProperties": false
										},
										"role": {
