{
	"openapi": "3.1.1",
	"info": { "title": "Workbench HTTP API", "version": "1" },
	"security": [{ "apiToken": [] }],
	"components": {
		"securitySchemes": { "apiToken": { "type": "http", "scheme": "bearer" } },
		"schemas": {
			"ProblemDetails": {
				"type": "object",
				"properties": {
					"type": { "type": "string" },
					"title": { "type": "string" },
					"status": { "type": "integer" },
					"detail": { "type": "string" },
					"code": { "type": "string" },
					"correlationId": { "type": "string" },
					"issues": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"path": {
									"type": "array",
									"items": { "type": ["string", "integer"] }
								},
								"message": { "type": "string" }
							},
							"required": ["path", "message"]
						}
					}
				},
				"required": [
					"type",
					"title",
					"status",
					"detail",
					"code",
					"correlationId",
					"issues"
				]
			}
		},
		"headers": {
			"CorrelationId": {
				"description": "the correlation ID of the request, also in its log entries",
				"required": true,
				"schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
			}
		}
	},
	"paths": {
		"/api/operations": {
			"get": {
				"operationId": "listOperations",
				"responses": {
					"200": {
						"description": "the operations of the core and the active plugins, sorted by name",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"operations": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"name": { "type": "string" },
													"kind": { "enum": ["query", "mutation"] }
												},
												"required": ["name", "kind"]
											}
										}
									},
									"required": ["operations"]
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the request failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/workspaces/{workspace}/operations/core.listAuditEntries": {
			"post": {
				"operationId": "core.listAuditEntries",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"limit": { "type": "integer", "minimum": 1, "maximum": 100 },
									"cursor": {
										"anyOf": [
											{ "type": "string", "maxLength": 200 },
											{ "type": "null" }
										]
									}
								},
								"required": ["limit", "cursor"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"entries": {
											"type": "array",
											"items": {
												"oneOf": [
													{
														"type": "object",
														"properties": {
															"id": { "type": "string" },
															"occurredAt": {
																"type": "string",
																"format": "date-time",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
															},
															"actor": {
																"type": "object",
																"properties": {
																	"kind": {
																		"type": "string",
																		"enum": ["user", "service_account"]
																	},
																	"id": { "type": "string" }
																},
																"required": ["kind", "id"],
																"additionalProperties": false
															},
															"apiTokenId": { "type": ["string", "null"] },
															"operation": { "type": "string" },
															"workspace": { "type": "string" },
															"result": {
																"type": "string",
																"const": "succeeded"
															}
														},
														"required": [
															"id",
															"occurredAt",
															"actor",
															"apiTokenId",
															"operation",
															"workspace",
															"result"
														],
														"additionalProperties": false
													},
													{
														"type": "object",
														"properties": {
															"id": { "type": "string" },
															"occurredAt": {
																"type": "string",
																"format": "date-time",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
															},
															"actor": {
																"type": "object",
																"properties": {
																	"kind": {
																		"type": "string",
																		"enum": ["user", "service_account"]
																	},
																	"id": { "type": "string" }
																},
																"required": ["kind", "id"],
																"additionalProperties": false
															},
															"apiTokenId": { "type": ["string", "null"] },
															"operation": { "type": "string" },
															"workspace": { "type": "string" },
															"result": { "type": "string", "const": "denied" },
															"reason": {
																"type": "string",
																"enum": [
																	"workspace_not_found",
																	"missing_right",
																	"object_not_found",
																	"not_object_holder"
																]
															}
														},
														"required": [
															"id",
															"occurredAt",
															"actor",
															"apiTokenId",
															"operation",
															"workspace",
															"result",
															"reason"
														],
														"additionalProperties": false
													}
												]
											}
										},
										"nextCursor": { "type": ["string", "null"] }
									},
									"required": ["entries", "nextCursor"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/workspaces/{workspace}/operations/reference.createNote": {
			"post": {
				"operationId": "reference.createNote",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "a key of the caller under which a repeated call receives the answer of the first instead of running the mutation again",
						"schema": { "type": "string", "pattern": "^[ -+\\--~]{1,255}$" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"title": {
										"type": "string",
										"minLength": 1,
										"maxLength": 200
									}
								},
								"required": ["title"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"id": { "type": "string" },
										"title": { "type": "string" },
										"createdAt": { "type": "string" }
									},
									"required": ["id", "title", "createdAt"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/workspaces/{workspace}/operations/reference.listNotes": {
			"post": {
				"operationId": "reference.listNotes",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"limit": { "type": "integer", "minimum": 1, "maximum": 100 }
								},
								"required": ["limit"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"notes": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"id": { "type": "string" },
													"title": { "type": "string" },
													"createdAt": { "type": "string" }
												},
												"required": ["id", "title", "createdAt"],
												"additionalProperties": false
											}
										}
									},
									"required": ["notes"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
		"/api/workspaces/{workspace}/operations/reference.renameNote": {
			"post": {
				"operationId": "reference.renameNote",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "a key of the caller under which a repeated call receives the answer of the first instead of running the mutation again",
						"schema": { "type": "string", "pattern": "^[ -+\\--~]{1,255}$" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"noteId": {
										"type": "string",
										"format": "uuid",
										"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
									},
									"title": {
										"type": "string",
										"minLength": 1,
										"maxLength": 200
									}
								},
								"required": ["noteId", "title"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"id": { "type": "string" },
										"title": { "type": "string" },
										"createdAt": { "type": "string" }
									},
									"required": ["id", "title", "createdAt"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		}
	}
}
