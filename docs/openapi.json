		"/api/workspaces/{workspace}/operations/core.listAuditEntries": {
			"post": {
				"operationId": "core.listAuditEntries",
				"parameters": [
					{
						"name": "workspace",
						"in": "path",
						"required": true,
						"schema": { "type": "string", "format": "uuid" }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"limit": { "type": "integer", "minimum": 1, "maximum": 100 },
									"cursor": {
										"anyOf": [
											{ "type": "string", "maxLength": 200 },
											{ "type": "null" }
										]
									}
								},
								"required": ["limit", "cursor"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "the output of the operation",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"entries": {
											"type": "array",
											"items": {
												"oneOf": [
													{
														"type": "object",
														"properties": {
															"id": { "type": "string" },
															"occurredAt": {
																"type": "string",
																"format": "date-time",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
															},
															"actor": {
																"type": "object",
																"properties": {
																	"kind": {
																		"type": "string",
																		"enum": ["user", "service_account"]
																	},
																	"id": { "type": "string" }
																},
																"required": ["kind", "id"],
																"additionalProperties": false
															},
															"apiTokenId": { "type": ["string", "null"] },
															"operation": { "type": "string" },
															"workspace": { "type": "string" },
															"result": {
																"type": "string",
																"const": "succeeded"
															},
															"member": {
																"anyOf": [
																	{
																		"type": "object",
																		"properties": {
																			"kind": {
																				"type": "string",
																				"enum": ["user", "service_account"]
																			},
																			"id": { "type": "string" }
																		},
																		"required": ["kind", "id"],
																		"additionalProperties": false
																	},
																	{ "type": "null" }
																]
															},
															"role": {
																"anyOf": [
																	{
																		"type": "string",
																		"pattern": "^[a-z][a-z0-9-]{0,62}$"
																	},
																	{ "type": "null" }
																]
															},
															"rights": {
																"type": "array",
																"items": { "type": "string" }
															}
														},
														"required": [
															"id",
															"occurredAt",
															"actor",
															"apiTokenId",
															"operation",
															"workspace",
															"result",
															"member",
															"role"
														],
														"additionalProperties": false
													},
													{
														"type": "object",
														"properties": {
															"id": { "type": "string" },
															"occurredAt": {
																"type": "string",
																"format": "date-time",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
															},
															"actor": {
																"type": "object",
																"properties": {
																	"kind": {
																		"type": "string",
																		"enum": ["user", "service_account"]
																	},
																	"id": { "type": "string" }
																},
																"required": ["kind", "id"],
																"additionalProperties": false
															},
															"apiTokenId": { "type": ["string", "null"] },
															"operation": { "type": "string" },
															"workspace": { "type": "string" },
															"result": { "type": "string", "const": "denied" },
															"reason": {
																"type": "string",
																"enum": [
																	"workspace_not_found",
																	"missing_right",
																	"object_not_found",
																	"not_object_holder",
																	"not_instance_admin"
																]
															}
														},
														"required": [
															"id",
															"occurredAt",
															"actor",
															"apiTokenId",
															"operation",
															"workspace",
															"result",
															"reason"
														],
														"additionalProperties": false
													}
												]
											}
										},
										"nextCursor": { "type": ["string", "null"] }
									},
									"required": ["entries", "nextCursor"],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "the request carries no valid API token",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					},
					"403": {
						"description": "the call was denied: missing_right",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/ProblemDetails" },
										{ "properties": { "code": { "enum": ["missing_right"] } } }
									]
								}
							}
						}
					},
					"404": {
						"description": "the call was denied: workspace_not_found",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/ProblemDetails" },
										{
											"properties": {
												"code": { "enum": ["workspace_not_found"] }
											}
										}
									]
								}
							}
						}
					},
					"default": {
						"description": "the operation failed",
						"headers": {
							"X-Correlation-ID": {
								"$ref": "#/components/headers/CorrelationId"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ProblemDetails" }
							}
						}
					}
				}
			}
		},
