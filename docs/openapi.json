												"minLength": 1,
												"maxLength": 200
											}
										},
										"required": ["kind", "id"]
									},
									"role": {
										"type": "string",
										"pattern": "^[a-z][a-z0-9-]{0,62}$"
									}
								},
								"required": ["actor", "role"]
