# Pflicht. Name des Compose-Projekts, je Mandant eindeutig; bestimmt die Namen von Volumes und Netzen.
COMPOSE_PROJECT_NAME=workbench-mandant
# Pflicht. Image der Workbench, etwa workbench:local nach docker build -t workbench:local .
WORKBENCH_IMAGE=workbench:local
# Pflicht. Port auf 127.0.0.1 des Hosts, an dem der Reverse Proxy die Instanz erreicht; je Mandant eindeutig.
WORKBENCH_PORT=8080
# Optional, Standard ./secrets. Verzeichnis (Rechte 700) mit den Docker-Secrets postgres_password (das Passwort) und database_url (postgres://workbench:<Passwort>@postgres:5432/workbench mit demselben Passwort), beide mit Rechten 644.
SECRETS_DIRECTORY=./secrets
# Optional, Standard info. debug, info, warn oder error.
LOG_LEVEL=info
# Optional, ohne Angabe ist kein Plugin aktiv. Namen der zu aktivierenden Plugins, durch Komma getrennt.
PLUGINS=reference
# Optional, Standard 2000. Frist der Datenbankprüfung im Readiness-Check in Millisekunden, 1 bis 60000.
READINESS_TIMEOUT_MS=
# Optional, Standard 10000. Frist je Plugin-Hook, Event-Handler und Job-Versuch in Millisekunden, 1 bis 600000.
PLUGIN_HOOK_TIMEOUT_MS=
