{
	"name": "workbench",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "bun run style && bun run typecheck && bun run test",
		"style": "biome ci .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@types/bun": "1.4.5",
		"typescript": "7.0.2"
	}
}
